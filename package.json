{
  "name": "dsh-prompt-input",
  "version": "0.4.0",
  "description": "Prompt 面板：点输入框工具行左侧的叠卡图标弹出气泡，搜索或点选预设短语，插入到草稿光标处（可撤销、不覆盖草稿）。Prompt pad beside the DSH composer: open a popover from the stacked-cards icon, search or click a saved phrase, and it is inserted at the caret as one undoable edit.",
  "type": "module",
  "license": "MIT",
  "author": "oWo1025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oWo1025/dsh-prompt-input.git"
  },
  "homepage": "https://github.com/oWo1025/dsh-prompt-input#readme",
  "bugs": {
    "url": "https://github.com/oWo1025/dsh-prompt-input/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "client-plugin",
    "prompt",
    "prompts",
    "prompt-library",
    "prompt-manager",
    "snippets",
    "quick-input",
    "quick-phrases",
    "quick-reply",
    "phrase-library",
    "presets",
    "templates",
    "composer",
    "i18n"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "presets.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "icon-256.png",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "contributors": [
    "cm860712ch-cloud (original dsh-quick-input)"
  ]
}
