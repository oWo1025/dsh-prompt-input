{
  "name": "dsh-prompt-input",
  "version": "0.3.2",
  "description": "快捷输入：点开输入框左侧的叠卡图标，从气泡里搜索/点选预设短语并插到光标处。Popover quick-phrase pad with search: open from ⊞ beside the composer, click a card to insert at the caret.",
  "type": "module",
  "license": "MIT",
  "author": "oWo1025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oWo1025/dsh-prompt-input.git"
  },
  "homepage": "https://github.com/oWo1025/dsh-prompt-input#readme",
  "bugs": {
    "url": "https://github.com/oWo1025/dsh-prompt-input/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "quick-input",
    "quick-phrases",
    "presets",
    "composer",
    "snippets",
    "i18n",
    "bilingual"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "presets.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "contributors": [
    "cm860712ch-cloud (original dsh-quick-input)"
  ]
}
